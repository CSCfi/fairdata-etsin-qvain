{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../js/*"],
      "@helpers": ["./test-helpers"],
      "@helpers/*": ["./test-helpers/*"],
      "@testdata/*": ["./__testdata__/*"]
    },
    "types": [
      // common types, should be same as the main tsconfig
      "node",
      "vite/client",
      // types specific to tests
      "vitest/globals"
    ]
  },
  "include": ["../js", "."], // include all
  "exclude": []
}
